# ============================================================
# Multi-Branch Commerce Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit real secrets.
# ============================================================

# --- Core ---
NODE_ENV=development

# PostgreSQL connection string (matches infra/docker/docker-compose.yml defaults)
# Local: hit Postgres directly. Production: prefer PgBouncer and keep Prisma pool small.
# Example prod (compose): postgresql://commerce:PASSWORD@pgbouncer:5432/commerce?schema=public&pgbouncer=true&connection_limit=5
DATABASE_URL=postgresql://commerce:commerce_dev_password@localhost:5432/commerce?schema=public

# Redis connection string (BullMQ queues, catalogue cache, shared rate limiting, session cache)
REDIS_URL=redis://localhost:6379

# API process roles (production compose sets these):
# DISABLE_WORKERS=1  → HTTP API only (no BullMQ workers in-process)
# WORKER_ONLY=1      → worker process (BullMQ / reservation expiry; no public HTTP)

# Optional seed overrides (local/dev only — never commit real production passwords)
# SEED_SUPERADMIN_USERNAME=rajan.chand
# SEED_SUPERADMIN_PASSWORD=

# --- Auth ---
# Secret used to sign session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- URLs ---
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production path mount for the admin Next app (empty/unset for local :3001).
# When Nginx proxies https://shop…/admin → admin container, set:
#   ADMIN_BASE_PATH=/admin
#   ADMIN_URL=https://shop.example.com/admin
# ADMIN_BASE_PATH=/admin

# --- Stripe (TEST keys in development — never commit live secrets) ---
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Without these, catalogue/admin work; storefront checkout shows a clear “Stripe not configured” banner
# and the API returns PAYMENT_PROVIDER_NOT_CONFIGURED (no silent failure).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional mirror for Next.js; storefront prefers GET /storefront/payment-config (uses STRIPE_PUBLISHABLE_KEY).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Local webhooks (required for payment_intent.succeeded → order PAID in dev):
#   1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
#   2. stripe login
#   3. stripe listen --forward-to localhost:4000/api/v1/payments/webhooks/stripe
#   4. Copy the whsec_… signing secret into STRIPE_WEBHOOK_SECRET below, restart API
# Orders become PAID only after verified server-side confirmation (webhook or confirm endpoint).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- POS / card terminal ---
# In-store POS uses a mock terminal display (approve/decline) by default — no Stripe Terminal
# SDK is required. Online storefront checkout still uses Stripe PaymentIntents above.
# To integrate real Stripe Terminal later, add and wire these (not used by the mock MVP):
# STRIPE_TERMINAL_LOCATION_ID=
# STRIPE_TERMINAL_READER_ID=
# See: https://stripe.com/docs/terminal

# --- Object storage (S3-compatible; MinIO in dev if desired) ---
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---
EMAIL_FROM=noreply@example.com
# EMAIL_PROVIDER=log | smtp  (default: log unless EMAIL_SMTP_HOST is set)
EMAIL_PROVIDER=log
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_SMTP_SECURE=false

# --- SMS (optional; defaults to LogSmsProvider in development) ---
# SMS_PROVIDER=log | twilio
# Log provider refuses to send when NODE_ENV=production (no phone/body logging in prod).
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- POS ---
# Mock card terminal approve/decline is for development only.
# In production it is disabled unless you explicitly set:
# ALLOW_MOCK_POS_TERMINAL=1
# (Do not enable on a live till — integrate a real card reader instead.)

# --- Google Gemini (optional). Without a key, SMS uses templates and catalogue uses curated HD photos. ---
# 1) Create a key: https://aistudio.google.com/apikey
# 2) Paste below (never commit the real key)
# 3) Restart the API: pnpm dev:api
# 4) Check status: GET /api/v1/health → integrations.gemini
#    or Admin → SMS → status banner / GET /api/v1/sms/gemini-status
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Image packshots for storefront (pnpm db:enrich-images):
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# STOREFRONT_PUBLIC_URL=http://localhost:3000
# ENRICH_IMAGE_LIMIT=5

# --- Observability ---
SENTRY_DSN=

# --- API ---
PORT=4000
