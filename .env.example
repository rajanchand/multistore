# ============================================================
# Multi-Branch Commerce Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit real secrets.
# ============================================================

# --- Core ---
NODE_ENV=development

# PostgreSQL connection string (matches infra/docker/docker-compose.yml defaults)
DATABASE_URL=postgresql://commerce:commerce_dev_password@localhost:5432/commerce?schema=public

# Redis connection string (BullMQ queues, caching, rate limiting)
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Secret used to sign session tokens. Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- URLs ---
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Stripe (use TEST keys in development: https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:4000/api/v1/payments/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# --- POS / card terminal ---
# In-store POS uses a mock terminal display (approve/decline) by default — no Stripe Terminal
# SDK is required. Online storefront checkout still uses Stripe PaymentIntents above.
# To integrate real Stripe Terminal later, add and wire these (not used by the mock MVP):
# STRIPE_TERMINAL_LOCATION_ID=
# STRIPE_TERMINAL_READER_ID=
# See: https://stripe.com/docs/terminal

# --- Object storage (S3-compatible; MinIO in dev if desired) ---
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---
EMAIL_FROM=noreply@example.com

# --- SMS (optional; defaults to LogSmsProvider in development) ---
# SMS_PROVIDER=log | twilio
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Google Gemini (optional; SMS auto-compose). Without a key, a template fallback is used. ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Observability ---
SENTRY_DSN=

# --- API ---
PORT=4000
